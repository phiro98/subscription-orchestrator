# --- Database & Cache Configurations ---
# Note: When running via docker-compose, these URLs are overridden in docker-compose.yml
# to use the internal Docker network hostnames ('postgres' and 'redis').
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/subscriptions_db
REDIS_URL=redis://localhost:6379/0
REDIS_LOCK_TTL_SECONDS=15

# --- Security & Third-Party Secrets ---
# Mock values for local development
WEBHOOK_SECRET=whsec_mock_secret_key_12345
API_KEY=sk_test_mock_api_key_98765
PAYMENT_GATEWAY_URL=https://api.mock-gateway.com/v1
